@ECHO OFF
IF NOT EXIST C:\V9XSAFE\MGA2\MGAPDX64.DRV GOTO FAIL
IF NOT EXIST C:\V9XSAFE\MGA2\MGAPDX64.VXD GOTO FAIL
IF NOT EXIST C:\V9XSAFE\MGA2\CANDDRV.DRV GOTO NOCAND
IF NOT EXIST C:\V9XSAFE\MGA2\CANDVXD.VXD GOTO NOCAND
IF EXIST C:\V9XSAFE\MGA2\ARMED.1 DEL C:\V9XSAFE\MGA2\ARMED.1 > NUL
IF EXIST C:\V9XSAFE\MGA2\ARMED.2 DEL C:\V9XSAFE\MGA2\ARMED.2 > NUL
ECHO ARMED>C:\V9XSAFE\MGA2\ARMED.1
ECHO ARMED>C:\V9XSAFE\MGA2\LASTBOOT.TXT
ECHO Guard armed. The first reboot runs the candidate; the second restores stock files.
GOTO END
:NOCAND
ECHO ERROR: Candidate staging files are missing. Run ACTIVATE.BAT first.
VERIFY OTHER > NUL
GOTO END
:FAIL
ECHO ERROR: Stock Matrox recovery files are missing. Run PREPARE.BAT first.
VERIFY OTHER > NUL
:END

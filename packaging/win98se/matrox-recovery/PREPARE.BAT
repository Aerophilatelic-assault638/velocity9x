@ECHO OFF
IF NOT EXIST C:\WINDOWS\SYSTEM\MGAPDX64.DRV GOTO NODRV
IF NOT EXIST C:\WINDOWS\SYSTEM\MGAPDX64.VXD GOTO NOVXD
IF NOT EXIST C:\V9XSAFE MD C:\V9XSAFE
IF NOT EXIST C:\V9XSAFE\MGA2 MD C:\V9XSAFE\MGA2
COPY /Y C:\WINDOWS\SYSTEM\MGAPDX64.DRV C:\V9XSAFE\MGA2\MGAPDX64.DRV > NUL
IF ERRORLEVEL 1 GOTO COPYFAIL
COPY /Y C:\WINDOWS\SYSTEM\MGAPDX64.VXD C:\V9XSAFE\MGA2\MGAPDX64.VXD > NUL
IF ERRORLEVEL 1 GOTO COPYFAIL
COPY /Y V9XGUARD.BAT C:\V9XSAFE\MGA2\V9XGUARD.BAT > NUL
IF ERRORLEVEL 1 GOTO COPYFAIL
COPY /Y ARM.BAT C:\V9XSAFE\MGA2\ARM.BAT > NUL
COPY /Y DISARM.BAT C:\V9XSAFE\MGA2\DISARM.BAT > NUL
COPY /Y RESTORE.BAT C:\V9XSAFE\MGA2\RESTORE.BAT > NUL
IF NOT EXIST V9XAUTO.EXE GOTO NOAUTO
COPY /Y C:\AUTOEXEC.BAT C:\V9XSAFE\MGA2\AUTOEXEC.BAK > NUL
IF ERRORLEVEL 1 GOTO AUTOCOPYFAIL
V9XAUTO.EXE
IF ERRORLEVEL 1 GOTO AUTOFIXFAIL
IF EXIST C:\V9XSAFE\MGA2\ARMED.1 DEL C:\V9XSAFE\MGA2\ARMED.1 > NUL
IF EXIST C:\V9XSAFE\MGA2\ARMED.2 DEL C:\V9XSAFE\MGA2\ARMED.2 > NUL
ECHO PREPARED>C:\V9XSAFE\MGA2\LASTBOOT.TXT
ECHO Velocity9x Matrox rollback guard prepared but not armed.
GOTO END
:NODRV
ECHO ERROR: C:\WINDOWS\SYSTEM\MGAPDX64.DRV is missing.
GOTO FAIL
:NOVXD
ECHO ERROR: C:\WINDOWS\SYSTEM\MGAPDX64.VXD is missing.
GOTO FAIL
:COPYFAIL
ECHO ERROR: Could not create the stock Matrox recovery copy.
GOTO FAIL
:NOAUTO
ECHO ERROR: V9XAUTO.EXE is missing from the current directory.
GOTO FAIL
:AUTOCOPYFAIL
ECHO ERROR: Could not back up C:\AUTOEXEC.BAT.
GOTO FAIL
:AUTOFIXFAIL
ECHO ERROR: Could not install the DOS-time guard in C:\AUTOEXEC.BAT.
COPY /Y C:\V9XSAFE\MGA2\AUTOEXEC.BAK C:\AUTOEXEC.BAT > NUL
:FAIL
VERIFY OTHER > NUL
:END

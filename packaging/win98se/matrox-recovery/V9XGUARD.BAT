@ECHO OFF
IF NOT EXIST C:\V9XSAFE\MGA2\ARMED.2 GOTO FIRST
COPY /Y C:\V9XSAFE\MGA2\MGAPDX64.DRV C:\WINDOWS\SYSTEM\MGAPDX64.DRV > NUL
IF ERRORLEVEL 1 GOTO FAILED
COPY /Y C:\V9XSAFE\MGA2\MGAPDX64.VXD C:\WINDOWS\SYSTEM\MGAPDX64.VXD > NUL
IF ERRORLEVEL 1 GOTO FAILED
DEL C:\V9XSAFE\MGA2\ARMED.2 > NUL
ECHO ROLLED-BACK>C:\V9XSAFE\MGA2\LASTBOOT.TXT
GOTO END
:FIRST
IF NOT EXIST C:\V9XSAFE\MGA2\ARMED.1 GOTO END
IF NOT EXIST C:\V9XSAFE\MGA2\CANDDRV.DRV GOTO CANDFAIL
IF NOT EXIST C:\V9XSAFE\MGA2\CANDVXD.VXD GOTO CANDFAIL
COPY /Y C:\V9XSAFE\MGA2\CANDDRV.DRV C:\WINDOWS\SYSTEM\MGAPDX64.DRV > NUL
IF ERRORLEVEL 1 GOTO CANDFAIL
COPY /Y C:\V9XSAFE\MGA2\CANDVXD.VXD C:\WINDOWS\SYSTEM\MGAPDX64.VXD > NUL
IF ERRORLEVEL 1 GOTO CANDFAIL
REN C:\V9XSAFE\MGA2\ARMED.1 ARMED.2
ECHO CANDIDATE-FIRST-BOOT>C:\V9XSAFE\MGA2\LASTBOOT.TXT
GOTO END
:CANDFAIL
COPY /Y C:\V9XSAFE\MGA2\MGAPDX64.DRV C:\WINDOWS\SYSTEM\MGAPDX64.DRV > NUL
COPY /Y C:\V9XSAFE\MGA2\MGAPDX64.VXD C:\WINDOWS\SYSTEM\MGAPDX64.VXD > NUL
IF EXIST C:\V9XSAFE\MGA2\ARMED.1 DEL C:\V9XSAFE\MGA2\ARMED.1 > NUL
IF EXIST C:\V9XSAFE\MGA2\ARMED.2 DEL C:\V9XSAFE\MGA2\ARMED.2 > NUL
ECHO CANDIDATE-COPY-FAILED>C:\V9XSAFE\MGA2\LASTBOOT.TXT
GOTO END
:FAILED
ECHO ROLLBACK-FAILED>C:\V9XSAFE\MGA2\LASTBOOT.TXT
:END

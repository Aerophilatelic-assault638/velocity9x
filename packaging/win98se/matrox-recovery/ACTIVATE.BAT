@ECHO OFF
IF NOT EXIST MGAPDX64.DRV GOTO NOCAND
IF EXIST KEEPVXD.TAG GOTO VXDREADY
IF NOT EXIST MGAPDX64.VXD GOTO NOCAND
:VXDREADY
IF NOT EXIST C:\V9XSAFE\MGA2\MGAPDX64.DRV GOTO NOBACKUP
IF NOT EXIST C:\V9XSAFE\MGA2\MGAPDX64.VXD GOTO NOBACKUP
FC /B C:\WINDOWS\SYSTEM\MGAPDX64.DRV C:\V9XSAFE\MGA2\MGAPDX64.DRV > NUL
IF ERRORLEVEL 1 GOTO STOCKMISMATCH
FC /B C:\WINDOWS\SYSTEM\MGAPDX64.VXD C:\V9XSAFE\MGA2\MGAPDX64.VXD > NUL
IF ERRORLEVEL 1 GOTO STOCKMISMATCH
COPY /Y MGAPDX64.DRV C:\V9XSAFE\MGA2\CANDDRV.DRV > NUL
IF ERRORLEVEL 1 GOTO COPYFAIL
IF EXIST KEEPVXD.TAG GOTO KEEPVXD
COPY /Y MGAPDX64.VXD C:\V9XSAFE\MGA2\CANDVXD.VXD > NUL
IF ERRORLEVEL 1 GOTO COPYFAIL
GOTO VERIFYVXD
:KEEPVXD
COPY /Y C:\V9XSAFE\MGA2\MGAPDX64.VXD C:\V9XSAFE\MGA2\CANDVXD.VXD > NUL
IF ERRORLEVEL 1 GOTO COPYFAIL
:VERIFYVXD
FC /B C:\V9XSAFE\MGA2\CANDDRV.DRV MGAPDX64.DRV > NUL
IF ERRORLEVEL 1 GOTO COPYFAIL
IF EXIST KEEPVXD.TAG GOTO ARM
FC /B C:\V9XSAFE\MGA2\CANDVXD.VXD MGAPDX64.VXD > NUL
IF ERRORLEVEL 1 GOTO COPYFAIL
:ARM
CALL C:\V9XSAFE\MGA2\ARM.BAT
IF NOT EXIST C:\V9XSAFE\MGA2\ARMED.1 GOTO ARMFAIL
ECHO Candidate staged and guard armed. Reboot exactly once.
GOTO END
:NOCAND
ECHO ERROR: Required candidate MGAPDX64 files are missing from the current directory.
GOTO FAIL
:NOBACKUP
ECHO ERROR: Stock recovery files are missing.
GOTO FAIL
:STOCKMISMATCH
ECHO ERROR: Active files do not match the validated stock recovery copy.
GOTO FAIL
:ARMFAIL
ECHO ERROR: Rollback guard did not arm.
GOTO FAIL
:COPYFAIL
ECHO ERROR: Candidate staging failed; active stock files were not changed.
CALL C:\V9XSAFE\MGA2\DISARM.BAT
:FAIL
VERIFY OTHER > NUL
:END

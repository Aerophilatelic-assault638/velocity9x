@ECHO OFF
IF EXIST C:\V9XSAFE\MGA2\ARMED.1 DEL C:\V9XSAFE\MGA2\ARMED.1 > NUL
IF EXIST C:\V9XSAFE\MGA2\ARMED.2 DEL C:\V9XSAFE\MGA2\ARMED.2 > NUL
ECHO DISARMED>C:\V9XSAFE\MGA2\LASTBOOT.TXT
IF "%1"=="NOSET" GOTO DONE
IF NOT EXIST C:\V9XSAFE\MGA2\CANDSET.DLL GOTO SETFAIL
IF NOT EXIST C:\V9XSAFE\MGA2\CANDSET.REG GOTO SETFAIL
COPY /Y C:\V9XSAFE\MGA2\CANDSET.DLL C:\WINDOWS\SYSTEM\V9XSETP.DLL > NUL
IF ERRORLEVEL 1 GOTO SETFAIL
REGEDIT /S C:\V9XSAFE\MGA2\CANDSET.REG
IF ERRORLEVEL 1 GOTO SETFAIL
ECHO Velocity9x Display Properties page installed.
:DONE
ECHO Guard disarmed. The current driver files will remain installed.
GOTO END
:SETFAIL
ECHO WARNING: Driver accepted, but the Velocity9x settings page was not installed.
:END

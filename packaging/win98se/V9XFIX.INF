; Normal-mode file replacement for an already installed Velocity9x candidate.

[Version]
Signature="$CHICAGO$"

[DefaultInstall]
CopyFiles=Velocity9x.Repair

[DestinationDirs]
Velocity9x.Repair=11

[SourceDisksNames]
1="Velocity9x repair files",,0

[SourceDisksFiles]
v9xdisp.drv=1
v9xmini.vxd=1

[Velocity9x.Repair]
v9xdisp.drv,,,12
v9xmini.vxd,,,12
